<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Casper</string>
    <key>CFBundleDisplayName</key>
    <string>Casper</string>
    <key>CFBundleExecutable</key>
    <string>casper</string>
    <key>CFBundleIdentifier</key>
    <string>com.github.alexandreroman.casper</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleShortVersionString</key>
    <string>__SHORT_VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__BUNDLE_VERSION__</string>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
    <!-- Casper's browser previews local dev servers reached via public-qualified hostnames (nip.io/sslip.io) that resolve to loopback but which ATS evaluates by hostname, not resolved IP; NSAllowsLocalNetworking does not cover them, so arbitrary loads are permitted. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <!-- Auto-update (Sparkle). Casper ships ad-hoc signed (no Developer ID, no
         notarization), so Sparkle cannot validate an update by code-signing
         continuity: SUPublicEDKey below is the ONLY trust anchor. Every appcast
         enclosure is signed with the matching private seed (the SPARKLE_PRIVATE_KEY
         repository secret) by the release workflow; an unsigned or mis-signed
         archive is rejected. Only the release bundle carries these keys —
         Info-dev.plist omits them, which is what keeps SoftwareUpdater inert in
         development builds. -->
    <key>SUFeedURL</key>
    <string>https://github.com/alexandreroman/casper/releases/latest/download/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>+y5n3ii5Xyp19iA26QmYeNbkXNyFqoePDqftYz6kTWE=</string>
    <!-- Check daily in the background; the user still confirms every install
         (SUAutomaticallyUpdate is deliberately left unset/false). Setting this
         explicitly also suppresses Sparkle's first-launch "check automatically?"
         prompt. -->
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
</dict>
</plist>
